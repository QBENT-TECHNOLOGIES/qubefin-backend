@QubeFin.Tracking.Api_HostAddress = http://localhost:5198

@token = <paste access token>

GET {{QubeFin.Tracking.Api_HostAddress}}/me
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{QubeFin.Tracking.Api_HostAddress}}/branches
Accept: application/json
Authorization: Bearer {{token}}

###

###

GET {{QubeFin.Tracking.Api_HostAddress}}/field-officers
Accept: application/json
Authorization: Bearer {{token}}

###

POST {{QubeFin.Tracking.Api_HostAddress}}/jobs/search
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "searchText": null,
  "status": null,
  "openOnly": false,
  "organisationUnitId": null,
  "assigneeId": null,
  "dueFrom": null,
  "dueTo": null,
  "dpdRange": null,
  "pageIndex": 0,
  "pageSize": 10,
  "sortOn": "endDate",
  "sortDirection": "asc"
}

###

@jobId = <paste job id>

GET {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}/history
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{QubeFin.Tracking.Api_HostAddress}}/jobs/task-points?pendingOnly=true
Accept: application/json
Authorization: Bearer {{token}}

###

@organisationUnitId = <paste branch id>

GET {{QubeFin.Tracking.Api_HostAddress}}/geo-tags/points?organisationUnitId={{organisationUnitId}}&kinds=GroupCentre,Member,OdMember
Accept: application/json
Authorization: Bearer {{token}}

###

POST {{QubeFin.Tracking.Api_HostAddress}}/jobs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "jobTitle": "Falakata OD follow-up, week 45",
  "jobDescription": "Visit OD members above 30 DPD first.",
  "assigneeId": "<employee id>",
  "startDate": null,
  "endDate": "2026-11-10",
  "tasks": [
    {
      "taskType": "OdFollowUp",
      "taskTitle": "OD follow-up: Anjali Barman",
      "notes": "Collect at least one instalment.",
      "priority": "High",
      "coOrdinatedBy": null,
      "target": { "kind": "OdMember", "originRefId": "<member id>", "targetName": "Anjali Barman", "targetLocation": null, "organisationUnitId": null }
    },
    {
      "taskType": "LeadSourcing",
      "taskTitle": "Lead sourcing near Falakata market",
      "notes": null,
      "priority": "Medium",
      "coOrdinatedBy": null,
      "target": { "kind": "Custom", "originRefId": null, "targetName": "Falakata market", "targetLocation": { "lat": 26.523900, "lng": 89.205100 }, "organisationUnitId": "<branch id>" }
    }
  ]
}

###

POST {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tasks": [
    {
      "taskType": "Survey",
      "taskTitle": "Survey near the school",
      "notes": null,
      "priority": "Low",
      "coOrdinatedBy": null,
      "target": { "kind": "Custom", "originRefId": null, "targetName": "School", "targetLocation": { "lat": 26.527500, "lng": 89.201200 }, "organisationUnitId": "<branch id>" }
    }
  ]
}

###

PUT {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}/transfer
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assigneeId": "<new designation id>",
  "taskIds": null,
  "remarks": "Assignee is on leave this week.",
  "endDate": null
}

###

PUT {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}/extend
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "endDate": "2026-11-30",
  "remarks": "Market day on Thursday."
}

###

PUT {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}/cancel
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remarks": "Branch closed for audit this week."
}

###

@taskId = <paste task id>

PUT {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}/tasks/{{taskId}}/cancel
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remarks": "Group meeting moved to next week."
}

###

PUT {{QubeFin.Tracking.Api_HostAddress}}/jobs/{{jobId}}/tasks/{{taskId}}/reject
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remarks": "Outside this job area."
}

###

GET {{QubeFin.Tracking.Api_HostAddress}}/geo-tags?kind=GroupCentre&onlyUntagged=false
Accept: application/json
Authorization: Bearer {{token}}
